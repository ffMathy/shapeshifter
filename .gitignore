/build/*
!/build/pad.xml
!/build/signing.pfx

bin/
obj/
artifacts/
TestResults/
*.user
.vs/
.vscode/
.idea/

# Copied in by website/preview.sh (the Pages workflow does the same at build time).
website/screenshots/
website/app-icons/

# Local Claude Code state (agent worktrees, personal settings); the shared settings are committed.
.claude/*
!.claude/settings.json

# AIL: the legacy app's runtime folder and caches
.ail/
node_modules/

# Python bytecode (packaging/store/listing/build_listing.py)
__pycache__/
